# Copy this file to .env and fill in YOUR values. Never commit .env and never put keys in the code.
# We use Microsoft Entra ID (az login), so there are no API keys at all.

# Azure OpenAI / Microsoft Foundry (the endpoint of the resource that holds your deployments)
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE-NAME.openai.azure.com
AZURE_OPENAI_CHAT_DEPLOYMENT=YOUR-CHAT-DEPLOYMENT-NAME
AZURE_OPENAI_EMBED_DEPLOYMENT=YOUR-EMBEDDING-DEPLOYMENT-NAME
# Must match the embedding model. text-embedding-3-small = 1536
EMBED_DIMENSIONS=1536

# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://YOUR-SEARCH-NAME.search.windows.net
AZURE_SEARCH_INDEX=rag-demo

# Blob Storage
AZURE_STORAGE_ACCOUNT_URL=https://YOURSTORAGEACCOUNT.blob.core.windows.net
AZURE_STORAGE_CONTAINER=docs

# --- Optional: use a local Ollama server instead of Azure OpenAI (no quota needed) ---
# LLM_PROVIDER=ollama
# AZURE_OPENAI_CHAT_DEPLOYMENT=llama3.2          (the Ollama chat model name)
# AZURE_OPENAI_EMBED_DEPLOYMENT=nomic-embed-text (the Ollama embedding model name)
# EMBED_DIMENSIONS=768                           (nomic-embed-text = 768; changing it needs a NEW index name)
# AZURE_SEARCH_INDEX=rag-demo-ollama
